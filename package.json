{
	"name": "contentclip",
	"version": "1.0.0",
	"private": true,
	"description": "Server-side AI clip production for long-form video.",
	"license": "AGPL-3.0-only",
	"author": "Fixt",
	"repository": {
		"type": "git",
		"url": "https://github.com/fixtse/ContentClip.git"
	},
	"bugs": {
		"url": "https://github.com/fixtse/ContentClip/issues"
	},
	"homepage": "https://github.com/fixtse/ContentClip#readme",
	"type": "module",
	"scripts": {
		"build": "next build apps/web",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate --config services/postgres/drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config services/postgres/drizzle.config.ts",
		"db:push": "drizzle-kit push --config services/postgres/drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config services/postgres/drizzle.config.ts",
		"deploy:check": "pnpm run check && pnpm run typecheck && pnpm run test:unit",
		"dev": "next dev apps/web --turbo",
		"preview": "pnpm build && pnpm start",
		"start": "next start apps/web",
		"test:integration": "vitest run --config apps/web/vitest.integration.config.ts",
		"test:integration:watch": "vitest --config apps/web/vitest.integration.config.ts",
		"test:unit": "vitest run --config apps/web/vitest.config.ts",
		"test:unit:coverage": "vitest run --config apps/web/vitest.config.ts --coverage",
		"test:unit:watch": "vitest --config apps/web/vitest.config.ts",
		"typecheck": "tsc --noEmit",
		"worker": "tsx --env-file=.env apps/worker/src/contentclip-worker.ts",
		"worker:dev": "tsx watch --env-file=.env apps/worker/src/contentclip-worker.ts"
	},
	"dependencies": {
		"@ai-sdk/google": "^3.0.68",
		"@ai-sdk/openai": "^3.0.62",
		"@aws-sdk/client-s3": "^3.1044.0",
		"@aws-sdk/lib-storage": "^3.1044.0",
		"@aws-sdk/s3-request-presigner": "^3.1044.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@electric-sql/pglite": "^0.4.5",
		"browser-transcription-runtime": "^4.2.0",
		"@napi-rs/canvas": "^1.0.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.100.9",
		"@trpc/client": "^11.17.0",
		"@trpc/react-query": "^11.17.0",
		"@trpc/server": "^11.17.0",
		"ai": "^6.0.175",
		"better-auth": "^1.6.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^12.38.0",
		"jsonrepair": "^3.14.0",
		"lucide-react": "^1.14.0",
		"next": "^16.2.5",
		"next-themes": "^0.4.6",
		"browser-runtime": "^1.25.1",
		"pgvector": "^0.2.1",
		"postgres": "^3.4.9",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-dropzone": "^15.0.0",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.6.0",
		"react-markdown": "^10.1.0",
		"react-player": "^3.4.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.5.0",
		"browser-media-demuxer": "^4.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "4.1.5",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.14",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@10.28.1"
}
