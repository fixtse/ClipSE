# syntax=docker/dockerfile:1.7

FROM python:3.11-slim

ARG HAILO_APPS_REF=main
ARG INSTALL_LOCAL_HAILORT=false

RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY hailo-packages/ /tmp/hailo-packages/
RUN --mount=type=bind,from=hailort_wheel_dir,source=.,target=/tmp/hailort-wheel-dir,readonly \
    set -eux; \
    wheel_path="$(find /tmp/hailort-wheel-dir -maxdepth 1 -type f \( -name 'hailort-*.whl' -o -name 'pyhailort-*.whl' \) | head -n 1)"; \
    if [ -z "${wheel_path}" ]; then \
        echo "The Hailo image requires HAILORT_WHEEL_DIR to contain hailort-*.whl or pyhailort-*.whl" >&2; \
        exit 1; \
    fi; \
    pip install --no-cache-dir "${wheel_path}"; \
    if [ "${INSTALL_LOCAL_HAILORT}" = "true" ] && ls /tmp/hailo-packages/hailort_*.deb >/dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y /tmp/hailo-packages/hailort_*.deb; \
        rm -rf /var/lib/apt/lists/*; \
    fi; \
    python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('hailo_platform') else 1)"

RUN git clone --depth 1 --branch "${HAILO_APPS_REF}" https://github.com/hailo-ai/hailo-apps.git /opt/hailo-apps

ENV PYTHONPATH="/opt/hailo-apps:${PYTHONPATH}" \
    HAILO_TRANSCRIBE_COMMAND="python /app/hailo_whisper_runner.py --audio {audio} --model {model} --language {language} {hef_arg}" \
    HAILO_VLM_FOCUS_COMMAND="python /app/hailo_vlm_focus_runner.py --video {video} --model {model} --start {start} --end {end} --sample-interval {sample_interval} --max-samples {max_samples} {hef_arg} {optimize_memory_arg}" \
    HAILO_VISION_COMMAND="python /app/hailo_vision_focus_runner.py --video {video} --model {model} --start {start} --end {end} --detection-mode {detection_mode} --sample-interval {sample_interval} --max-samples {max_samples} {hef_arg} {ocr_hef_arg} {object_labels_arg}" \
    WHISPER_PROVIDER="hailo"

COPY app.py hailo_whisper_runner.py hailo_vlm_focus_runner.py hailo_vision_focus_runner.py ./

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
