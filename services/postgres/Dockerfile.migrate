FROM node:24-bookworm-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates openssl \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"

RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY services/postgres/drizzle.config.ts ./services/postgres/drizzle.config.ts
COPY services/postgres/migrations ./services/postgres/migrations
COPY apps/web/src/server/db/schema.ts ./apps/web/src/server/db/schema.ts

CMD ["pnpm", "db:migrate"]
