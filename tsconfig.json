{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"checkJs": true,
		/* Bundled projects */
		"lib": ["dom", "dom.iterable", "ES2022"],
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		],
		"incremental": true,
		/* Path Aliases */
		"baseUrl": ".",
		"paths": {
			"~/*": ["./apps/web/src/*"]
		}
	},
	"include": [
		"apps/web/next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.cjs",
		"**/*.js",
		"apps/web/.next/types/**/*.ts",
		"apps/web/.next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "generated", ".next", "apps/web/coverage"]
}
